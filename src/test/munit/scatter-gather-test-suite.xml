<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:http="http://www.mulesoft.org/schema/mule/http"
    xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns:module-error-handler-plugin="http://www.mulesoft.org/schema/mule/module-error-handler-plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/module-error-handler-plugin http://www.mulesoft.org/schema/mule/module-error-handler-plugin/current/mule-module-error-handler-plugin.xsd">

    <munit:config name="scatter-gather-test-suite.xml" />

    <!--
        Real-flow tests for Scatter-Gather composite errors (wayfinder ticket 006).
        Failing routes raise genuine connector/module errors so the caught error is a real
        MULE:COMPOSITE_ROUTING with childErrors - no serialized fixtures.
    -->

    <http:request-config name="sgDeadEndpointConfig">
        <http:request-connection host="localhost" port="${dead.endpoint.port}" />
    </http:request-config>

    <flow name="sg-mixed-failures-helper-flow">
        <scatter-gather>
            <route>
                <validation:is-true expression="#[false]" message="Route 0 validation failed" />
            </route>
            <route>
                <http:request config-ref="sgDeadEndpointConfig" method="GET" path="/nope" />
            </route>
        </scatter-gather>
    </flow>

    <flow name="sg-validation-only-helper-flow">
        <scatter-gather>
            <route>
                <validation:is-true expression="#[false]" message="Route 0 validation failed" />
            </route>
            <route>
                <validation:is-true expression="#[false]" message="Route 1 validation failed" />
            </route>
        </scatter-gather>
    </flow>

    <munit:test
        name="scatter-gather-default-resolution-is-unknown-500"
        description="A real Scatter-Gather composite error (MULE:COMPOSITE_ROUTING) has no default mapping and returns UNKNOWN 500 when resolveNestedErrors is off.">
        <munit:execution>
            <try>
                <flow-ref name="sg-mixed-failures-helper-flow" />
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="testError" value="#[error]" />
                    </on-error-continue>
                </error-handler>
            </try>
            <module-error-handler-plugin:process-error
                error="#[vars.testError]" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[%dw 2.0 import getErrorTypeAsString from module_error_handler_plugin::common --- getErrorTypeAsString(vars.testError.errorType)]"
                is="#[MunitTools::equalTo('MULE:COMPOSITE_ROUTING')]" />
            <munit-tools:assert-that
                expression="#[attributes.httpStatus]"
                is="#[MunitTools::equalTo(500)]" />
        </munit:validation>
    </munit:test>

    <munit:test
        name="scatter-gather-unwrap-picks-highest-status-leaf"
        description="With resolveNestedErrors=true the mixed failing routes (VALIDATION:* 400 and HTTP:CONNECTIVITY 503) resolve to the highest status: 503.">
        <munit:execution>
            <try>
                <flow-ref name="sg-mixed-failures-helper-flow" />
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="testError" value="#[error]" />
                    </on-error-continue>
                </error-handler>
            </try>
            <module-error-handler-plugin:process-error
                error="#[vars.testError]"
                resolveNestedErrors="true" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[attributes.httpStatus]"
                is="#[MunitTools::equalTo(503)]" />
            <munit-tools:assert-that
                expression="#[payload.error.reason]"
                is="#[MunitTools::equalTo('Service Unavailable')]" />
        </munit:validation>
    </munit:test>

    <munit:test
        name="scatter-gather-unwrap-resolves-validation-leaves-to-400"
        description="With resolveNestedErrors=true a Scatter-Gather whose routes fail only with validation errors resolves to the VALIDATION:* mapping (400).">
        <munit:execution>
            <try>
                <flow-ref name="sg-validation-only-helper-flow" />
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="testError" value="#[error]" />
                    </on-error-continue>
                </error-handler>
            </try>
            <module-error-handler-plugin:process-error
                error="#[vars.testError]"
                resolveNestedErrors="true" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[attributes.httpStatus]"
                is="#[MunitTools::equalTo(400)]" />
        </munit:validation>
    </munit:test>

    <munit:test
        name="scatter-gather-previous-error-aggregates-route-failures"
        description="getPreviousErrorMessage extracts the failing routes' messages from a real childErrors tree.">
        <munit:execution>
            <try>
                <flow-ref name="sg-validation-only-helper-flow" />
                <error-handler>
                    <on-error-continue>
                        <set-variable variableName="testError" value="#[error]" />
                        <set-variable
                            variableName="testPreviousError"
                            value="#[%dw 2.0 import getPreviousErrorMessage from module_error_handler_plugin::common --- getPreviousErrorMessage(vars.testError)]" />
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.testPreviousError]"
                is="#[MunitTools::containsString('Route 0 validation failed')]" />
            <munit-tools:assert-that
                expression="#[vars.testPreviousError]"
                is="#[MunitTools::containsString('Route 1 validation failed')]" />
        </munit:validation>
    </munit:test>

</mule>
