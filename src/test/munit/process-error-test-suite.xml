    <munit:test
        name="resolve-nested-errors-picks-highest-status"
        description="With mixed leaf types the numeric-max status wins: a 404 and a 503 child resolve to 503.">
        <munit:behavior>
            <set-variable
                variableName="testError"
                value='#[%dw 2.0 --- readUrl("classpath://examples/ScatterGather.json", "application/json") update {
                    case .childErrors -> [
                        { errorType: { namespace: "HTTP", identifier: "NOT_FOUND" } },
                        { errorType: { namespace: "HTTP", identifier: "SERVICE_UNAVAILABLE" } }
                    ]
                }]' />
        </munit:behavior>
        <munit:execution>
            <module-error-handler-plugin:process-error
                error="#[vars.testError]"
                resolveNestedErrors="true" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[attributes.httpStatus]"
                is="#[MunitTools::equalTo(503)]" />
        </munit:validation>
    </munit:test>

